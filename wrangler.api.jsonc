{
  // Worker da Public API — servido em api.movepark.co (E0.7). Ver docs/specs/public-api.md.
  // Deploy: `bun run deploy:api`. Segredos: `wrangler secret put SUPABASE_ANON_KEY -c wrangler.api.jsonc`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movepark-api",
  "main": "src/api-worker.ts",
  // conta Cloudflare dona da zona movepark.co (Financeiro@fera.ag)
  "account_id": "d124ffde17489256e3417b4e82275c6c",
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "api.movepark.co", "custom_domain": true },
    { "pattern": "mcp.movepark.co", "custom_domain": true }
  ],
  "vars": {
    "SUPABASE_FUNCTIONS_URL": "https://mgaigbezdalbyuqiofcf.supabase.co/functions/v1",
    "SITE_URL": "https://movepark.co"
  },
  // Freio best-effort de 60 req/min: por prefixo de chave em /v1/*, por IP nas tools de OTP.
  // Era um contador escrito sobre KV, que cobrava uma escrita por requisição e queimou a
  // cota grátis (1.000/dia) num teste de flood em 12/08/2026, derrubando a API com 500.
  // O binding nativo conta dentro da Cloudflare: sem escrita, sem cota, atômico por
  // localidade. Mudar o limite aqui é config, não deploy de lógica.
  "ratelimits": [
    { "name": "API_RATELIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ]
  // SUPABASE_ANON_KEY é secret (não versionar).
}
