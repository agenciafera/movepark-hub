# Claude Code — config pessoal (permissões locais), por dev; não versionar
.claude/settings.local.json

# direnv — o `windup claude login --profile` escreve aqui um CLAUDE_CONFIG_DIR
# com caminho absoluto da home de quem rodou. É por máquina, não por projeto.
.envrc

# Supabase
supabase/.temp/
supabase/.branches/

# Deps — usamos bun; o lockfile versionado é bun.lock (texto)
node_modules/
package-lock.json
bun.lockb
yarn.lock
pnpm-lock.yaml
dist/
build/
*.log

# TypeScript build info
*.tsbuildinfo

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
.impeccable/

# Imagens-fonte dos estacionamentos (cruas). As otimizadas vão em public/Estacionamentos/.
/docs/Todos os estacionamentos/

