# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Relatório de cobertura do Vitest — gerado, some a cada run
coverage/

# Env / secrets — .env é versionado (só contém chaves públicas VITE_*)
.env.local
.env.*.local

# Claude Code — config pessoal (permissões locais), por dev; não versionar
.claude/settings.local.json

# direnv — o `windup claude login --profile` escreve aqui um CLAUDE_CONFIG_DIR
# com caminho absoluto da home de quem rodou. É por máquina, não por projeto.
.envrc

# Supabase
supabase/.temp/
supabase/.branches/

# Deps: usamos bun; o lockfile versionado é bun.lock (texto)
# Sem a barra final de propósito. Com ela o padrão casa só diretório, e em 15/08/2026 um
# SYMLINK chamado node_modules (apontando para a máquina de outro dev) escapou do ignore e
# foi versionado. Quem desse pull recebia o symlink no lugar do diretório real, e como o
# conteúdo estava ignorado o git apagava as deps instaladas sem avisar.
node_modules
package-lock.json
bun.lockb
yarn.lock
pnpm-lock.yaml
dist/
build/
*.log

# TypeScript build info
*.tsbuildinfo

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
.impeccable/

# Imagens-fonte dos estacionamentos (cruas). As otimizadas vão em public/Estacionamentos/.
/docs/Todos os estacionamentos/

# Playwright MCP artifacts
.playwright-mcp/
_originals/

# Playwright E2E
.auth/
.env.e2e
playwright-report/
test-results/
