{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movepark-hub",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-02",
  "vars": {
    // Leitura pública do catálogo de posts, para o worker confirmar slug que o
    // manifesto do build ainda não tem. A anon key é pública por design e já
    // vive no .env versionado; a RLS é que decide o que ela enxerga.
    "SUPABASE_URL": "https://mgaigbezdalbyuqiofcf.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1nYWlnYmV6ZGFsYnl1cWlvZmNmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk3MTcxOTksImV4cCI6MjA5NTI5MzE5OX0.H7f344gtsOeMF3dyCQTpfBNvjPhQkKXVrhlIDmZ85LE"
  },
  "observability": {
    "enabled": true
  },
  // O apex NÃO entra aqui: `movepark.co` está preso a este worker por **Custom Domain**, que é
  // outro recurso e não é gerenciado por esta lista. Medido em 18/08/2026 antes de mexer: a zona
  // tinha zero routes, então esta entrada é aditiva. Se um dia o apex virar route, ele PRECISA
  // entrar nesta lista junto, porque o deploy substitui o conjunto de routes pelo que está aqui.
  //
  // O `www` existe só para o worker devolver 301 para o apex (ver `redirecionaWww` no worker.ts).
  // Antes disso ele respondia 522, porque tinha registro DNS proxiado para uma origem morta.
  "routes": [
    { "pattern": "www.movepark.co/*", "zone_name": "movepark.co" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Roda o worker ANTES de servir o asset — necessário para a content-negotiation de
    // Markdown-for-Agents (E0.8-c) valer nas páginas reais (que têm HTML pré-renderizado).
    // Sem isto, o asset é servido primeiro e o worker.ts nunca roda em / e nas rotas SSG.
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
