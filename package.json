{
  "name": "movepark-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "node --import ./scripts/ws-polyfill.mjs node_modules/.bin/vite",
    "build": "tsc -b && node --import ./scripts/ws-polyfill.mjs node_modules/.bin/vite-react-ssg build && node scripts/canonicalize-sitemap.mjs",
    "preview": "bun run build && wrangler dev",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit && tsc -p e2e/playwright/tsconfig.json --noEmit",
    "test": "./scripts/vitest-run.sh --project unit",
    "test:unit": "./scripts/vitest-run.sh --project unit",
    "test:watch": "vitest --project unit",
    "test:int": "./scripts/vitest-run.sh --project integration",
    "test:db": "supabase test db",
    "test:edge": "deno test --no-check --allow-env --allow-net --allow-read supabase/functions",
    "coverage": "./scripts/vitest-run.sh --project unit --coverage",
    "gen:types": "supabase gen types typescript --linked > src/types/database.ts",
    "deploy": "bun run build && wrangler deploy",
    "deploy:api": "wrangler deploy -c wrangler.api.jsonc",
    "gen:cards": "node scripts/gen-card-hashes.mjs",
    "lint:openapi": "node scripts/check-openapi-drift.mjs",
    "test:windup": "windup run --all",
    "report:windup": "windup run --all --reporter json --base-url ${WINDUP_BASE_URL:-http://localhost:5173} && node scripts/windup-suite-report.mjs",
    "test:e2e": "NODE_OPTIONS=\"--import ./scripts/ws-polyfill.mjs\" playwright test",
    "test:e2e:ui": "NODE_OPTIONS=\"--import ./scripts/ws-polyfill.mjs\" playwright test --ui",
    "test:e2e:smoke": "NODE_OPTIONS=\"--import ./scripts/ws-polyfill.mjs\" playwright test --project=e2e-public --project=smoke"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.13",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.2",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^1.3.0",
    "react-hook-form": "^7.84.0",
    "react-phone-number-input": "^3.4.17",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-react-ssg": "^0.9.2",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "js-yaml": "^5.2.3",
    "lefthook": "^2.1.10",
    "msw": "^2.15.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "secretlint": "^13.0.4",
    "tailwindcss": "^3.4.19",
    "turndown": "^7.2.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "windupjs": "1.9.0",
    "wrangler": "^4.120.0"
  },
  "patchedDependencies": {
    "windupjs@1.9.0": "patches/windupjs@1.9.0.patch"
  }
}
