# Copy to .env.local and fill in
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Search Console (baseline de conteúdo, `bun run seo:gsc-baseline`). Caminho do JSON da
# service account com acesso de leitura em sc-domain:movepark.co, ou o JSON inline.
# O arquivo da chave fica FORA do repo (ex.: ~/.config/movepark/gsc-service-account.json).
GSC_SERVICE_ACCOUNT_JSON=/caminho/para/gsc-service-account.json
